{
  "expo": {
    "name": "KidsGourmet",
    "slug": "kidsgourmet-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kidsgourmet",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFBE6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kidsgourmet.mobile",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Çocuğunuzun veya profilinizin fotoğrafını seçmek için galeri erişimine ihtiyacımız var.",
        "NSCameraUsageDescription": "Çocuğunuzun veya profilinizin fotoğrafını çekmek için kamera erişimine ihtiyacımız var.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.944387456679-nuv4qnlq1lvrdpl1llp31sf30n8mm1j3"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFBE6"
      },
      "package": "com.kidsgourmet.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Çocuğunuzun veya profilinizin fotoğrafını seçmek için galeri erişimine ihtiyacımız var.",
          "cameraPermission": "Çocuğunuzun veya profilinizin fotoğrafını çekmek için kamera erişimine ihtiyacımız var."
        }
      ],
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "googleIosClientId": "944387456679-nuv4qnlq1lvrdpl1llp31sf30n8mm1j3.apps.googleusercontent.com",
      "googleAndroidClientId": "944387456679-a5lakgnpnskuvpeia7kv4d9firtll81p.apps.googleusercontent.com",
      "googleWebClientId": "944387456679-mis73fvvfhh7p715mm50j45v61l01ljh.apps.googleusercontent.com",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6d10376f-faf7-4177-9192-35d6ab7e1d5f"
      }
    }
  }
}
